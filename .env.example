# Application
APP_NAME=Wordle Backend
ENVIRONMENT=development
DEBUG=false

# Leave blank for routes such as /me and /games.
# Set to /api/v1 if you want versioned routes such as /api/v1/me.
API_V1_PREFIX=

# Supabase Cloud Postgres only.
# Use the direct connection string or Supabase pooler string from:
# Supabase Dashboard -> Project Settings -> Database -> Connection string.
# Do not use SQLite, localhost, or a local Postgres database.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth values from:
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]

# Preferred modern verification for Supabase asymmetric JWT signing keys.
SUPABASE_JWKS_URL=https://[PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://[PROJECT-REF].supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=RS256,ES256

# Only set this for legacy Supabase projects that still use symmetric JWT secrets.
# If you use this, also set SUPABASE_JWT_ALGORITHMS=HS256.
# SUPABASE_JWT_SECRET=[YOUR-SUPABASE-JWT-SECRET]

# Game rules
ALLOWED_WORD_LENGTHS=4,5,6,7
DEFAULT_MAX_ATTEMPTS=6
ENFORCE_DICTIONARY_GUESSES=true
ONE_ACTIVE_CLASSIC_GAME_PER_LENGTH=true
DAILY_CHALLENGE_TIMEZONE=UTC
GUESSES_RATE_LIMIT_PER_MINUTE=30

# Admin protection for word management and daily generation.
# Comma-separated Supabase auth user UUIDs.
ADMIN_USER_IDS=

# CORS origins for your frontend, comma-separated.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Scoring. Format: word_length:base_score comma-separated.
SCORE_BASE_BY_LENGTH=4:80,5:100,6:130,7:160
SCORE_WIN_BONUS=25
SCORE_REMAINING_ATTEMPT_BONUS=10
SCORE_DAILY_BONUS=20
